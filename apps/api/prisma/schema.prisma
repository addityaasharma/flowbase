generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  MEMBER
}
enum Status {
  TODO
  IN_PROGRESS
  IN_REVIEW
  BLOCKED
  DONE
}
enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}
enum TicketType {
  TASK
  BUG
  FEATURE
  IMPROVEMENT
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  name         String
  title        String?
  passwordHash String
  role         Role            @default(MEMBER)
  active       Boolean         @default(true)
  tokenVersion  Int             @default(0)   // bumped on password change/reset: signs out every other session
  emailVerifiedAt DateTime?
  authTokens   AuthToken[]
  apiTokens    ApiToken[]
  ticketRepos  TicketRepo[]
  createdAt    DateTime        @default(now())
  memberships  ProjectMember[]
  assignedTickets TicketAssignee[]
  reported     Ticket[]        @relation("Reporter")
  comments     Comment[]
  activities   Activity[]
  invitesSent  Invitation[]
  uploads      Upload[]
  notifications Notification[]
}

model Project {
  id          String          @id @default(cuid())
  name        String
  key         String
  description String?
  repoUrl     String?         // https://github.com/owner/repo, shown to people and handed to Claude/agents
  repoBranch  String?
  ticketSeq   Int             @default(0)
  createdAt   DateTime        @default(now())
  members     ProjectMember[]
  tickets     Ticket[]
  invitations Invitation[]
}

model ProjectMember {
  projectId String
  userId    String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role    @default(MEMBER) // role inside this project; the creator is ADMIN
  @@id([projectId, userId])
}

model Ticket {
  id          String     @id @default(cuid())
  number      Int
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  type        TicketType @default(TASK)
  priority    Priority   @default(MEDIUM)
  status      Status     @default(TODO)
  position    Float      @default(0)
  labels      String[]
  dueDate     DateTime?
  assignees   TicketAssignee[]
  reporterId  String
  reporter    User       @relation("Reporter", fields: [reporterId], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  comments    Comment[]
  activities  Activity[]
  notifications Notification[]
  reminders   Reminder[]
  subtasks    Subtask[]
  repos       TicketRepo[]

  @@unique([projectId, number])
  @@index([projectId, status, position])
}

model Comment {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  viaAgent  String?  // name of the API token when an agent (e.g. Claude) wrote it on someone's behalf
  parentId  String?
  parent    Comment? @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("Replies")
  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}

model Activity {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  message   String
  viaAgent  String?
  createdAt DateTime @default(now())
}

model Invitation {
  id          String    @id @default(cuid())
  email       String
  tokenHash   String    @unique
  role        Role      @default(MEMBER)
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedById String
  invitedBy   User      @relation(fields: [invitedById], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([email])
}

model TicketAssignee {
  ticketId   String
  userId     String
  assignedAt DateTime @default(now())
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([ticketId, userId])
  @@index([userId])
}

/// One row per stored image: lets us enforce per-user quotas and clean up images nobody uses any more.
model Upload {
  id        String   @id @default(cuid())
  name      String   @unique
  bytes     Int
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

/// Inbox entry for one person. Kept until read for 30 days / 90 days at most (see cleanup).
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  actorId   String?
  actorName String?
  kind      String
  text      String
  projectId String?
  ticketId  String?
  ticket    Ticket?   @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

/// One-time links sent by email: password reset and email verification. Only a hash of the token is stored.
model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String    // "reset" | "verify"
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, kind])
}

/// Remembers which due-date reminders were already sent, so each one goes out once (a new due date re-arms it).
model Reminder {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  kind      String   // "due-soon" | "overdue"
  dueDate   DateTime
  sentAt    DateTime @default(now())

  @@unique([ticketId, kind, dueDate])
}

/// Personal access token for agents (e.g. Claude Code over MCP). Acts as the user, with the same rights as an assigned person.
model ApiToken {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  prefix           String    // first characters, so the owner can recognise it; the rest is never stored
  tokenHash        String    @unique
  canCommentOthers Boolean   @default(true)  // may read + comment on tasks that are not assigned to the user
  expiresAt        DateTime?
  lastUsedAt       DateTime?
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId])
}

/// A checklist item inside a ticket. Whoever may edit the ticket (assignees, creator) may change these.
model Subtask {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  title     String
  done      Boolean  @default(false)
  position  Float    @default(0)
  createdAt DateTime @default(now())

  @@index([ticketId, position])
}

/// A GitHub repo attached to one task by someone working on it. The project may also have a default repo.
model TicketRepo {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  url       String
  branch    String?
  addedById String
  addedBy   User     @relation(fields: [addedById], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([ticketId, url])
}
