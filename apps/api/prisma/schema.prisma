generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  MEMBER
}
enum Status {
  TODO
  IN_PROGRESS
  IN_REVIEW
  BLOCKED
  DONE
}
enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}
enum TicketType {
  TASK
  BUG
  FEATURE
  IMPROVEMENT
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  name         String
  title        String?
  passwordHash String
  role         Role            @default(MEMBER)
  active       Boolean         @default(true)
  createdAt    DateTime        @default(now())
  memberships  ProjectMember[]
  assignedTickets TicketAssignee[]
  reported     Ticket[]        @relation("Reporter")
  comments     Comment[]
  activities   Activity[]
  invitesSent  Invitation[]
  uploads      Upload[]
  notifications Notification[]
}

model Project {
  id          String          @id @default(cuid())
  name        String
  key         String
  description String?
  ticketSeq   Int             @default(0)
  createdAt   DateTime        @default(now())
  members     ProjectMember[]
  tickets     Ticket[]
  invitations Invitation[]
}

model ProjectMember {
  projectId String
  userId    String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role    @default(MEMBER) // role inside this project; the creator is ADMIN
  @@id([projectId, userId])
}

model Ticket {
  id          String     @id @default(cuid())
  number      Int
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  type        TicketType @default(TASK)
  priority    Priority   @default(MEDIUM)
  status      Status     @default(TODO)
  position    Float      @default(0)
  labels      String[]
  dueDate     DateTime?
  assignees   TicketAssignee[]
  reporterId  String
  reporter    User       @relation("Reporter", fields: [reporterId], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  comments    Comment[]
  activities  Activity[]
  notifications Notification[]

  @@unique([projectId, number])
  @@index([projectId, status, position])
}

model Comment {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  parentId  String?
  parent    Comment? @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("Replies")
  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}

model Activity {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  message   String
  createdAt DateTime @default(now())
}

model Invitation {
  id          String    @id @default(cuid())
  email       String
  tokenHash   String    @unique
  role        Role      @default(MEMBER)
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedById String
  invitedBy   User      @relation(fields: [invitedById], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([email])
}

model TicketAssignee {
  ticketId   String
  userId     String
  assignedAt DateTime @default(now())
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([ticketId, userId])
  @@index([userId])
}

/// One row per stored image: lets us enforce per-user quotas and clean up images nobody uses any more.
model Upload {
  id        String   @id @default(cuid())
  name      String   @unique
  bytes     Int
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

/// Inbox entry for one person. Kept until read for 30 days / 90 days at most (see cleanup).
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  actorId   String?
  actorName String?
  kind      String
  text      String
  projectId String?
  ticketId  String?
  ticket    Ticket?   @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([userId, createdAt])
  @@index([userId, readAt])
}
