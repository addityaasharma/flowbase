DATABASE_URL="postgresql://bitcode:bitcode@localhost:5432/bitcode_tracker?schema=public"
JWT_SECRET="change-me"
# Who gets emailed about server errors and from the server health check (backups, disk, downtime)
# ALERT_EMAIL="you@example.com"
# Where pasted/attached images are stored (defaults to ./uploads). In production keep it OUTSIDE the deployed code folder.
# UPLOAD_DIR="/var/www/bitcode-tracker-data/uploads"
# Cloudflare R2 (private bucket) for pasted/attached images. When all four are set, NEW images go to R2 and are streamed back through the API;
# older images still on disk keep working (copy them over once with: pnpm --filter @bitcode/api uploads:migrate). Leave unset to keep using the disk.
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# Storage guards (defaults shown): per-person quota, per-person uploads per day, whole-folder cap, and the free-disk floor below which uploads stop
# UPLOAD_USER_QUOTA_MB=100
# UPLOAD_USER_PER_DAY=100
# UPLOAD_TOTAL_MAX_MB=2048
# UPLOAD_MIN_FREE_MB=5120
PORT=4000
# WEB_ORIGIN="https://tracker.example.com"  # set in production to restrict CORS

# Invitations / email (Resend: https://resend.com/api-keys)
WEB_URL="http://localhost:3000"            # public address of the web app; used in invite links
RESEND_API_KEY=""                          # leave empty in dev: the invite link is shown in the UI + server log
RESEND_FROM="Flowbase <onboarding@resend.dev>"  # use a verified domain in production
